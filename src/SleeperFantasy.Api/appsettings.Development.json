{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sleeper_fantasy;Username=sleeper;Password=sleeper"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "Providers": {
    "SleeperBaseUrl": "https://api.sleeper.app",
    "NflverseBaseUrl": "https://github.com/nflverse/nflverse-data/releases/download",
    "InjuryReportBaseUrl": "https://www.nfl.com/injuries",
    "LanguageModel": "None",
    "GeminiModel": "gemini-2.0-flash",
    "GeminiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "GeminiResultTtlMinutes": 30,
    "LanguageModelTimeoutSeconds": 30,
    "LanguageModelMaxPromptCharacters": 24000
  },
  "Cache": {
    "DefaultTtlHours": 24,
    "SleeperTtlHours": 24,
    "NflverseTtlHours": 24,
    "InjuryReportTtlHours": 24,
    "MaxEntriesPerProvider": 100
  },
  "Runtime": {
    "PublicBaseUrl": "http://localhost:5187"
  },
  "Identity": {
    "AdministratorEmail": "admin@example.invalid",
    "AdministratorPassword": "LocalDevelopmentPassword1!",
    "RequireHttps": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
